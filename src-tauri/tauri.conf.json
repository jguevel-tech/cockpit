{
  "productName": "Cockpit",
  "identifier": "com.cockpit.dev",
  "version": "../package.json",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cockpit",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QTEyQjYxN0VCNDgzMzkKUldRNWc3UitZU3VoYUoydzkyTjZEUDJKMCtwRytxa3loSFVPa3YycE1jS0U3am5SR2owZFl4UU8K",
      "endpoints": [
        "https://github.com/jguevel-tech/cockpit/releases/latest/download/latest.json"
      ]
    }
  }
}
