/// Copie via fichier temporaire + rename : ecrire directement dans un binaire[m
/// potentiellement en cours d'execution echoue (ETXTBSY) ou corrompt le process[m us.[m
fn copy_executable(src: &std::path::Path, dest: &std::path::Path) -> Result<(), [m String> {[m
    let dir = dest.parent().ok_or("chemin sans parent")?;[m
    std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;[m
    let tmp = dir.join("tmux.new");[m
    std::fs::copy(src, &tmp).map_err(|e| e.to_string())?;[m
