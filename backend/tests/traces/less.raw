/// Taille du tampon de lecture du PTY. Ne change RIEN a la latence : `read()` r[m end la main[m
/// des qu'UN octet est disponible, l'echo d'une touche part donc toujours seul.[m  Mais sur une[m
/// rafale, chaque lecture devient un evenement de moins — banc du 2026-08-20 su[m r une rafale[m
/// de 1,9 Mo a travers un vrai PTY : 2547 evenements en 8 Ko, 3 avec ce tampon [m :[K[Ket le[m
/// regroupement de `pomper`.[m
const PTY_READ_BUF: usize = 64 * 1024;[m
[m
/// Au-dela de ce volume en attente, on considere qu'une RAFALE est en cours et [m on laisse[m
/// `PTY_GROUP_WAIT` d'accumulation avant d'emettre. En dessous, emission immedi[m ate.[m
///[m
/// 8 Ko d'un coup ne peuvent pas etre de la frappe : l'echo d'une touche fait q[m uelques[m
/// octets, un redraw de prompt quelques centaines. Le seuil ne se declenche don[m c jamais[m
/// sur le chemin de frappe, dont la latence reste inchangee.[m
const PTY_GROUP_THRESHOLD: usize = 8 * 1024;[m
[m
/// Fenetre d'accumulation en rafale. 2 ms : un huitieme d'image a 60 Hz, donc i[m nvisible,[m
/// et assez pour agreger plusieurs lectures. NE PAS monter a 20-50 ms « pour mi[m eux[m
/// regrouper » : ce serait payer en latence percue ce qu'on gagne en nombre d'e[m venements.[m
const PTY_GROUP_WAIT: std::time::Duration = std::time::Duration::from_millis(2);[m
