{
  "name": "cockpit",
  "desktopName": "cockpit.desktop",
  "private": true,
  "description": "Coquille Electron de Cockpit : fenetre Chromium et pont vers le backend Rust.",
  "main": "main.js",
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "version": "0.63.2",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "backend": ". ../../.claude/env-construction.sh && cd ../backend && cargo build --release",
    "paquet": "npm run backend && electron-builder"
  },
  "build": {
    "appId": "com.cockpit.dev",
    "productName": "Cockpit",
    "directories": {
      "output": "paquet"
    },
    "files": [
      "*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "interface"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "../backend/icons/128x128@2x.png",
      "executableName": "cockpit",
      "syncDesktopName": true,
      "description": "Terminaux, notes, fichiers et git, projet par projet",
      "extraResources": [
        {
          "from": "../backend/target/release/cockpit",
          "to": "cockpit"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jguevel-tech",
        "repo": "cockpit"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "../backend/icons/icon.icns",
      "identity": null,
      "extraResources": [
        {
          "from": "../backend/target/release/cockpit",
          "to": "cockpit"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../backend/icons/icon.ico",
      "extraResources": [
        {
          "from": "../backend/target/release/cockpit.exe",
          "to": "cockpit.exe"
        }
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
